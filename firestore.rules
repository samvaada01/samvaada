rules_version = '2';

// Live rules for samvaada-nmamit. Kept in the repo so they get reviewed and can
// be rolled back — they were console-only state before.
//
// Deploy with:  npx firebase-tools@latest deploy --only firestore:rules
//
// The admin address must match VITE_ADMIN_EMAIL. Anything not matched below is
// denied by default, so new collections need a block adding here.
service cloud.firestore {
  match /databases/{database}/documents {

    // Event archive. Public read: the homepage lists events before sign-in.
    // Writes are admin-only — `request.auth != null` alone would let any of the
    // thousands of college accounts delete the archive.
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email.lower() == "samvaada@nmamit.in";
    }

    // Homepage "Photo Gallery" collage — siteContent/photoGallery { urls: [...] }
    //
    // This MUST stay a sibling of /events, not nested inside it. Nested, it
    // would guard /events/{eventId}/siteContent/{docId} instead, and the app's
    // read of the top-level document would still be denied.
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email.lower() == "samvaada@nmamit.in";
    }
  }
}
